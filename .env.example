# Lanifex — semua model AI bisa diganti bebas (OpenAI-compatible endpoint)

# Endpoint LLM (default: 9Router lokal di host). Di Docker pakai host.docker.internal.
LLM_BASE_URL=http://host.docker.internal:20128/v1
LLM_API_KEY=
LLM_MODEL=code

# Override per tahap (opsional — kosong = pakai LLM_MODEL)
# LLM_MODEL_QUESTIONS=gemini/gemini-3-flash-preview
# LLM_MODEL_PRD=openrouter/anthropic/claude-sonnet-4
# LLM_MODEL_FEATURES=groq/llama-3.3-70b-versatile

# Server
PORT=8788
# MOCK_LLM=1   # tanpa provider: output deterministik untuk demo/test
